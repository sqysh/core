{
  "name": "coastalreferralxchange",
  "version": "1.12.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--no-deprecation' next dev --turbo -H 0.0.0.0",
    "build": "npm run generate && next build",
    "start": "next start",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "generate": "prisma generate",
    "send-changelog": "node scripts/send-changelog.js",
    "show-users": "node scripts/show-users.js",
    "seed:stripe-products": "node --env-file=.env scripts/seed-stripe-products.js",
    "seed:meeting": "node --env-file=.env scripts/seed-meeting.js",
    "send:card-reminder": "node --env-file=.env scripts/card-reminder.js",
    "seed:game-test": "node --env-file=.env scripts/seed-game-test.js",
    "seed:game-test:clean": "node --env-file=.env scripts/seed-game-test.js --clean",
    "seed:game-test:reset": "npm run seed:game-test:clean && npm run seed:game-test",
    "seed:test-member": "node --env-file=.env scripts/seed-test-member.js",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.10.0",
    "@hookform/resolvers": "^7.0.3",
    "@next/third-parties": "^16.0.7",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@splinetool/react-spline": "^4.1.0",
    "@splinetool/runtime": "^1.12.92",
    "@stripe/react-stripe-js": "^6.1.0",
    "@stripe/stripe-js": "^9.1.0",
    "@types/stripe": "^8.0.416",
    "firebase": "^11.9.1",
    "framer-motion": "^12.4.3",
    "jspdf": "^4.0.0",
    "lucide-react": "^0.511.0",
    "next": "^16.2.9",
    "next-auth": "^5.0.0-beta.30",
    "pdfjs-dist": "^6.5.438",
    "pusher": "^5.3.2",
    "pusher-js": "^8.4.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.0",
    "resend": "^4.6.0",
    "stripe": "^22.1.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^18.0.9",
    "eslint": "^9",
    "eslint-config-next": "^16.4.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
