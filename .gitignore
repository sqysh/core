# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.local
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

src/generated/
# local HTTPS dev certificates and keys (mkcert)
/certificates/

# environment master models: hundreds of MB each, kept outside Git (see assets/environment/masters/README.md)
/assets/environment/masters/**/*.glb

# draft-quality GLBs: regenerable from public/models/environment/ via scripts/environment/draft-decimator.mjs
/public/models/environment-derived/draft/

# LOD variants: regenerable from public/models/environment/ via scripts/environment/lod-generator.mjs
/public/models/environment-derived/lod/

# terrain lab build stages (scripts/environment/terrain-lab/build.py): intermediate meshes and bakes, regenerable
/scripts/environment/terrain-lab/work/
